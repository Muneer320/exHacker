# Copy this file to .env in the repository root. Never commit the real .env.
# Live testing: docs/TESTING.md#live-testing-with-your-api-keys
ENV=development
EXHACKER_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./exhacker.db

# BYOK is the default. Users connect provider keys through AI session settings.
# Backend RAM only; run exactly one API process with its embedded worker.
AI_ACCESS_MODE=byok
AI_LEASE_SECONDS=1800

# Optional operator mode: AI_ACCESS_MODE=operator. Never used as a BYOK fallback.
# Supported prefixes: openai/, anthropic/, gemini/, xai/, groq/.
AI_MODEL=openai/gpt-6-luna
AI_API_KEY=
# Optional operator OpenAI Responses base only; unavailable to BYOK users.
# AI_BASE_URL=https://your-provider.example/v1

# Search stays operator-managed in both modes.
TAVILY_API_KEY=

# Verify these operator-mode rates. BYOK uses the server catalog rate snapshot.
AI_INPUT_USD_PER_MILLION=3.0
AI_OUTPUT_USD_PER_MILLION=15.0
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=12000
STUDIO_COST_LIMIT=5.0
STUDIO_SEARCH_LIMIT=100
STUDIO_IDEA_ROUNDS=2
STUDIO_JOB_LEASE_SECONDS=300
STUDIO_WORKER_ENABLED=true
STUDIO_CONTEXT_CHAR_LIMIT=180000
FREE_TIER_PROJECTS_PER_DAY=3
MAX_PROJECTS_PER_USER=50

# Explicit offline evaluation only. Not allowed with ENV=production.
STUDIO_DEMO_MODE=false

# Only needed for direct cross-origin API access; the normal UI uses a proxy.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
