# Copy this file to .env in the repository root. Never commit the real .env.
ENV=development
EXHACKER_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./exhacker.db

# Live mode is the default. Use a LiteLLM provider-qualified text model.
# Adapter support does not mean every model fits this workflow's context/output size.
# Credentials are operator-configured today. User BYOK is not implemented yet.
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=
# Optional: custom compatible inference endpoint.
# AI_BASE_URL=https://your-provider.example/v1
TAVILY_API_KEY=

# Verify these rates for your selected model. Budget tracking uses these values.
AI_INPUT_USD_PER_MILLION=3.0
AI_OUTPUT_USD_PER_MILLION=15.0
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=12000
STUDIO_COST_LIMIT=5.0
STUDIO_SEARCH_LIMIT=100
STUDIO_IDEA_ROUNDS=2
STUDIO_JOB_LEASE_SECONDS=300
STUDIO_WORKER_ENABLED=true
STUDIO_CONTEXT_CHAR_LIMIT=180000
FREE_TIER_PROJECTS_PER_DAY=3
MAX_PROJECTS_PER_USER=50

# Explicit offline evaluation only. Not allowed with ENV=production.
STUDIO_DEMO_MODE=false

# Optional: avoid fetching LiteLLM's public model-cost map at import time.
# exHacker uses the explicit pricing values above for its own accounting.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Only needed for direct cross-origin API access; the normal UI uses a proxy.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
