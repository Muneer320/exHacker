# exHacker Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Application
APP_NAME=exHacker
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://exhacker:exhacker@localhost:5432/exhacker
DATABASE_SYNC_URL=postgresql+psycopg2://exhacker:exhacker@localhost:5432/exhacker
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# LLM Provider Selection
# Options: groq, gemini, ollama, openai, auto (fallback: Groq→Gemini→Ollama→OpenAI)
LLM_PROVIDER=auto

# Groq (primary - free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (secondary - free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local - zero cost, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (last resort fallback - requires billing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Agent Configuration
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=2

# Sentry
SENTRY_DSN=

# Postgres (Docker Compose)
POSTGRES_USER=exhacker
POSTGRES_PASSWORD=exhacker
POSTGRES_DB=exhacker
POSTGRES_PORT=5432
