# =============================================================================
# exHacker - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
#   cp .env.example .env
# =============================================================================

# --- Application -----------------------------------------------------------

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# FastAPI debug mode
DEBUG=true

# API prefix for versioned routes
API_PREFIX=/api/v1

# Comma-separated CORS origins for frontend access
CORS_ORIGINS=["http://localhost:3000"]

# Agent execution timeout in seconds
AGENT_TIMEOUT_SECONDS=120

# Max retries per agent step on failure
AGENT_MAX_RETRIES=2

# --- Database --------------------------------------------------------------

# Async PostgreSQL connection string (used by SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://exhacker:exhacker@localhost:5432/exhacker

# Sync PostgreSQL connection string (used by Alembic migrations)
DATABASE_SYNC_URL=postgresql+psycopg2://exhacker:exhacker@localhost:5432/exhacker

# SQLAlchemy echo mode (logs all SQL queries)
DATABASE_ECHO=false

# Connection pool size
DATABASE_POOL_SIZE=10

# Max pool overflow connections
DATABASE_MAX_OVERFLOW=20

# --- LLM Providers ---------------------------------------------------------
# Provider order priority: Groq -> Gemini -> Ollama -> OpenAI
# Set LLM_PROVIDER=auto to enable automatic fallback chain.
# Set LLM_PROVIDER=groq (or gemini, ollama, openai) to pin a specific provider.

# Primary provider selection: auto | groq | gemini | ollama | openai
LLM_PROVIDER=auto

# --- Groq (Primary) --------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (Fallback 1) ---------------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (Fallback 2, local) --------------------------------------------
# Requires Ollama running locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI (Fallback 3) ---------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# --- Research Services -----------------------------------------------------
# (Optional) API keys for external research providers.
# Add keys as needed when implementing competitor search, API discovery, etc.

# --- Frontend --------------------------------------------------------------
# Base URL for the backend API (used by Next.js client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Export Configuration --------------------------------------------------
# (Optional) Configure artifact export paths and limits.

# --- Monitoring ------------------------------------------------------------
# Sentry DSN for error tracking (optional)
SENTRY_DSN=
