# exHacker Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Application
APP_NAME=exHacker
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://exhacker:exhacker@localhost:5432/exhacker
DATABASE_SYNC_URL=postgresql+psycopg2://exhacker:exhacker@localhost:5432/exhacker
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# LLM Provider Selection
# Options: openai, grok, gemini, ollama, auto (fallback chain)
LLM_PROVIDER=auto

# OpenAI (fallback if no other provider available)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# xAI / Grok (primary - free tier available)
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Google Gemini (secondary - free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local - zero cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Agent Configuration
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_RETRIES=2

# Sentry
SENTRY_DSN=

# Postgres (Docker Compose)
POSTGRES_USER=exhacker
POSTGRES_PASSWORD=exhacker
POSTGRES_DB=exhacker
POSTGRES_PORT=5432
