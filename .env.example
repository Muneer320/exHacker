# exHacker — Environment Configuration
# Copy to .env and fill in your values

# Environment
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./exhacker.db

# AI Provider (openai, anthropic, litellm)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_TIER_1=gpt-4o-mini
AI_MODEL_TIER_2=gpt-4o
AI_MODEL_TIER_3=o3-mini

# Mock modes — no API keys needed
MOCK_AI=false
MOCK_RESEARCH=true

# Research
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Limits
FREE_TIER_PROJECTS_PER_DAY=3
PRO_TIER_PROJECTS_PER_DAY=50
MAX_PROJECTS_PER_USER=50
MAX_COST_PER_PROJECT=0.50

# Auth (v2 — not needed for MVP)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
SECRET_KEY=change-me-in-production

# Feature flags
FEATURE_PITCH_GENERATION=false
FEATURE_TEAM_COLLABORATION=false
FEATURE_EXPORT_PDF=false
