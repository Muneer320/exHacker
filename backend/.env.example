# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=exHacker

# Database Settings
# For local SQLite development (default)
DATABASE_URL=sqlite+aiosqlite:///./exhacker.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/exhacker

# LLM Providers API Keys
# Groq: support comma-separated keys for rate-limit rotation
GROQ_API_KEY=your-groq-key-1,your-groq-key-2

# Google Gemini (Fallback 1)
GEMINI_API_KEY=your-gemini-key

# OpenAI (Fallback 2)
OPENAI_API_KEY=your-openai-key

# Ollama Host (Local Fallback)
OLLAMA_HOST=http://localhost:11434

# Research settings
MOCK_RESEARCH=True
# Search Provider (Tavily, Serper, etc. if not mocked)
SEARCH_API_KEY=your-search-api-key
